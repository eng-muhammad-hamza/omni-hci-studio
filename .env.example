# OmniHCI Studio Configuration

# Ollama Local LLM Settings
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# Whisper ASR Model Size (tiny, base, small, medium, large)
WHISPER_SIZE=base

# Audio Settings
SAMPLE_RATE=16000

# Dialogue Settings
MAX_HISTORY=10

# Gradio Web Server Port
SERVER_PORT=7860
